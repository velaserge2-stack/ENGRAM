    "fflate": "^0.8.3",
    "lucide-preact": "^1.71.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0",
    "sql.js": "^1.16.0",
    "ts-fsrs": "^5.4.2",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
