{
  "name": "engrama",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Repetición espaciada + notas, PWA offline para Safari en iPad. Tus datos son archivos de texto.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
