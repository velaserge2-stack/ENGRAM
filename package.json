    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs",
    "e2e:design": "node e2e/design.mjs",
    "e2e:flows": "node e2e/flows.mjs",
    "e2e:mejoras": "node e2e/mejoras.mjs",
    "e2e:mejoras2": "node e2e/mejoras2.mjs",
    "e2e:phone": "node e2e/phone.mjs",
    "e2e:bloquec": "node e2e/bloquec.mjs",
    "e2e:p5": "node e2e/p5.mjs",
    "e2e:p6": "node e2e/p6.mjs",
    "e2e:p7": "node e2e/p7.mjs",
    "e2e:p10": "node e2e/p10.mjs",
    "e2e:p12": "node e2e/p12.mjs",
    "e2e:p15": "node e2e/p15.mjs",
    "e2e:reproductor": "node e2e/reproductor.mjs",
    "e2e:perf": "node e2e/perf.mjs"
  },
  "dependencies": {
    "docx": "^9.15.3",
    "dompurify": "^3.4.17",
